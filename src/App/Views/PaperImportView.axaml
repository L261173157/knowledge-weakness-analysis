<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KnowledgeWeakness.App.ViewModels"
             xmlns:domain="using:KnowledgeWeakness.Core.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
             x:Class="KnowledgeWeakness.App.Views.PaperImportView"
             x:DataType="vm:PaperImportViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Background="White"
                CornerRadius="8" Padding="16" Margin="0,0,0,12"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="学生" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent}"
                              HorizontalAlignment="Stretch" Margin="0,4,12,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="domain:Student">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="学科" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="0" Grid.Column="3"
                              ItemsSource="{Binding Subjects}"
                              SelectedItem="{Binding SelectedSubject}"
                              HorizontalAlignment="Stretch" Margin="0,4,0,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="domain:Subject">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="卷名" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title}" Margin="0,4,12,0"
                             PlaceholderText="如：第二单元测验"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="日期" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CalendarDatePicker Grid.Row="1" Grid.Column="3"
                                        SelectedDate="{Binding PaperDate}" Margin="0,4,0,0"
                                        HorizontalAlignment="Stretch"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Content="选择图片" Command="{Binding PickImagesCommand}"/>
                    <Button Content="清空" Command="{Binding ClearImagesCommand}"/>
                    <Button Content="识别" Command="{Binding ExtractCommand}" Classes="accent"
                            IsEnabled="{Binding !IsBusy}"/>
                    <Button Content="保存入库" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding !IsBusy}"/>
                </StackPanel>
                <CheckBox Content="我已完成逐题校对，确认这份卷子可进入薄弱分析"
                          IsChecked="{Binding IsReviewConfirmed}"
                          Margin="0,2,0,0"/>
                <TextBox Text="{Binding Status}" IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         MaxHeight="120" Foreground="#374151" FontSize="12"
                         Background="#F9FAFB" BorderBrush="#E5E7EB"/>

                <ItemsControl ItemsSource="{Binding Images}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F3F4F6" CornerRadius="4"
                                    Padding="8,4" Margin="0,0,6,6">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White"
                CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Questions}"
                      GridLinesVisibility="All"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="题号" Binding="{Binding Number}" Width="70"/>
                    <DataGridTemplateColumn Header="题型" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ExtractedQuestionRow">
                                <TextBlock Text="{Binding Type}" VerticalAlignment="Center" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate DataType="vm:ExtractedQuestionRow">
                                <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:PaperImportViewModel)DataContext).QuestionTypes}"
                                          SelectedItem="{Binding Type}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="题干" Binding="{Binding Stem}" Width="2*"/>
                    <DataGridTextColumn Header="标准答案" Binding="{Binding StandardAnswer}" Width="*"/>
                    <DataGridTextColumn Header="学生答案" Binding="{Binding StudentAnswer}" Width="*"/>
                    <DataGridCheckBoxColumn Header="正确" Binding="{Binding IsCorrect}" Width="60"/>
                    <DataGridTextColumn Header="得分" Binding="{Binding PartialScore}" Width="70"/>
                    <DataGridTextColumn Header="批注" Binding="{Binding TeacherComment}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Expander Grid.Row="2" Header="原始 JSON（调试）" Margin="0,12,0,0">
            <TextBox Text="{Binding RawJson}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"
                     MaxHeight="180"/>
        </Expander>
    </Grid>
</UserControl>
