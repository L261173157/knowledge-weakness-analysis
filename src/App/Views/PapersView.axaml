<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KnowledgeWeakness.App.ViewModels"
             xmlns:domain="using:KnowledgeWeakness.Core.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="KnowledgeWeakness.App.Views.PapersView"
             x:DataType="vm:PapersViewModel">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="2*,3*" RowSpacing="14" ColumnSpacing="14">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="card" Padding="16">
            <Grid ColumnDefinitions="Auto,180,Auto,180,*,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="field-label" Text="学生"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Students}"
                          SelectedItem="{Binding SelectedStudent}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="domain:Student">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Classes="field-label" Text="学科"/>
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding Subjects}"
                          SelectedItem="{Binding SelectedSubject}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="domain:Subject">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="5" Content="刷新" Command="{Binding LoadCommand}" Classes="accent"/>
                <Button Grid.Column="6" Content="清除筛选" Command="{Binding ClearFilterCommand}"/>
                <Button Grid.Column="7"
                        Content="{Binding DeleteButtonText}"
                        Command="{Binding DeleteCommand}"
                        Classes="danger"
                        ToolTip.Tip="第一次点击进入确认状态，5 秒内再次点击才真正删除"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Classes="card-flush">
            <DataGrid ItemsSource="{Binding Papers}"
                      SelectedItem="{Binding SelectedPaper}"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="学生" Binding="{Binding StudentName}" Width="80"/>
                    <DataGridTextColumn Header="学科" Binding="{Binding SubjectName}" Width="80"/>
                    <DataGridTextColumn Header="卷名" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="题数" Binding="{Binding QuestionCount}" Width="60"/>
                    <DataGridTextColumn Header="正确率" Binding="{Binding AccuracyText}" Width="76"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="76"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Classes="card-flush">
            <Grid RowDefinitions="Auto,*" Margin="16">
                <TextBlock Grid.Row="0" Text="{Binding DetailTitle}" Classes="section-title" Margin="0,0,0,10"/>
                <TabControl Grid.Row="1">
                    <TabItem Header="题目">
                        <DataGrid ItemsSource="{Binding Questions}"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="题号" Binding="{Binding Number}" Width="64" MinWidth="64"/>
                                <DataGridTextColumn Header="题型" Binding="{Binding Type}" Width="90" MinWidth="90"/>
                                <DataGridTextColumn Header="题干" Binding="{Binding Stem}" Width="2*" MinWidth="200"/>
                                <DataGridTextColumn Header="学生答案" Binding="{Binding StudentAnswer}" Width="*" MinWidth="100"/>
                                <DataGridTextColumn Header="标准答案" Binding="{Binding StandardAnswer}" Width="*" MinWidth="100"/>
                                <DataGridTextColumn Header="判定" Binding="{Binding CorrectText}" Width="64" MinWidth="64"/>
                                <DataGridTextColumn Header="批注" Binding="{Binding TeacherComment}" Width="*" MinWidth="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="原图">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding ImagePaths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}" Stretch="Uniform" MaxHeight="500" Margin="0,0,0,12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="status-bar">
            <TextBlock Text="{Binding Status}" Classes="status-text"/>
        </Border>
    </Grid>
</UserControl>
