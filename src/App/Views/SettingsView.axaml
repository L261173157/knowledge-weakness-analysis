<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KnowledgeWeakness.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="KnowledgeWeakness.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

            <Border Background="White" CornerRadius="8" Padding="20"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="智谱 GLM" FontWeight="SemiBold"/>
                    <TextBlock Text="API Key"/>
                    <TextBox Text="{Binding GlmApiKey}" PasswordChar="●"
                             PlaceholderText="从 open.bigmodel.cn 获取"/>
                    <TextBlock Text="模型"/>
                    <TextBox Text="{Binding GlmModel}"
                             PlaceholderText="glm-4.6v / glm-4.6v-flashx / glm-4.6v-flash"/>
                    <TextBlock Text="API Key 经 Windows DPAPI 加密后仅存本机。"
                               Foreground="#6B7280" FontSize="12"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="保存" Command="{Binding SaveCommand}" Classes="accent"/>
                <Button Content="重新加载" Command="{Binding LoadCommand}"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Foreground="#6B7280" FontSize="12" Margin="8,0,0,0"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
