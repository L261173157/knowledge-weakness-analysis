<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KnowledgeWeakness.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="KnowledgeWeakness.App.Views.StudentsView"
             x:DataType="vm:StudentsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,340" RowSpacing="16" ColumnSpacing="16">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="card" Padding="18">
            <Grid ColumnDefinitions="Auto,180,Auto,140,*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="field-label" Text="姓名"/>
                <TextBox Grid.Column="1" Text="{Binding NewName}" PlaceholderText="例如：张三"/>
                <TextBlock Grid.Column="2" Classes="field-label" Text="年级"/>
                <TextBox Grid.Column="3" Text="{Binding NewGrade}" PlaceholderText="例如：初二"/>
                <Button Grid.Column="5" Content="新增学生" Command="{Binding AddCommand}" Classes="accent"/>
                <Button Grid.Column="6" Content="刷新" Command="{Binding LoadCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Classes="card-flush">
            <DataGrid ItemsSource="{Binding Students}"
                      SelectedItem="{Binding Selected}"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="年级" Binding="{Binding Grade}" Width="140"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Classes="card" Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="学生详情" Classes="section-title"/>
                <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="10">
                    <TextBlock Classes="field-label" Text="ID"/>
                    <TextBlock Text="{Binding Selected.Id}" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Classes="field-label" Text="姓名"/>
                    <TextBox Text="{Binding Selected.Name}"/>
                    <TextBlock Classes="field-label" Text="年级"/>
                    <TextBox Text="{Binding Selected.Grade}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                        <Button Content="保存修改" Command="{Binding SaveCommand}" Classes="accent"/>
                        <Button Content="删除" Command="{Binding DeleteCommand}" Classes="danger"/>
                    </StackPanel>
                </StackPanel>
                <Border IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"
                        Background="{StaticResource SubtlePanelBrush}"
                        CornerRadius="8"
                        Padding="16">
                    <TextBlock Text="选择左侧学生后，在这里查看和编辑详情。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="status-bar">
            <TextBlock Text="{Binding Status}" Classes="status-text"/>
        </Border>
    </Grid>
</UserControl>
