<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KnowledgeWeakness.App.ViewModels"
             xmlns:domain="using:KnowledgeWeakness.Core.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="KnowledgeWeakness.App.Views.StudentsView"
             x:DataType="vm:StudentsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,320">

        <!-- 顶部：新增表单 -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="White"
                CornerRadius="8" Padding="16" Margin="0,0,0,12"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="姓名" VerticalAlignment="Center"/>
                <TextBox Text="{Binding NewName}" Width="160" PlaceholderText="如：张三"/>
                <TextBlock Text="年级" VerticalAlignment="Center"/>
                <TextBox Text="{Binding NewGrade}" Width="100" PlaceholderText="如：初二"/>
                <Button Content="新增" Command="{Binding AddCommand}" Classes="accent"/>
                <Button Content="刷新" Command="{Binding LoadCommand}"/>
            </StackPanel>
        </Border>

        <!-- 左侧：学生列表 -->
        <Border Grid.Row="1" Grid.Column="0" Background="White"
                CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1"
                Margin="0,0,12,0">
            <DataGrid ItemsSource="{Binding Students}"
                      SelectedItem="{Binding Selected}"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="160"/>
                    <DataGridTextColumn Header="年级" Binding="{Binding Grade}" Width="120"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 右侧：详情编辑 -->
        <Border Grid.Row="1" Grid.Column="1" Background="White"
                CornerRadius="8" Padding="16"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="详情" FontWeight="SemiBold" FontSize="14"/>
                <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="8">
                    <TextBlock Text="ID"/>
                    <TextBlock Text="{Binding Selected.Id}" FontWeight="Bold"/>
                    <TextBlock Text="姓名"/>
                    <TextBox Text="{Binding Selected.Name}"/>
                    <TextBlock Text="年级"/>
                    <TextBox Text="{Binding Selected.Grade}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Content="保存" Command="{Binding SaveCommand}" Classes="accent"/>
                        <Button Content="删除" Command="{Binding DeleteCommand}" Foreground="#DC2626"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"
                           Text="选择左侧记录查看详情" Foreground="#6B7280"/>
            </StackPanel>
        </Border>

        <!-- 底部：状态栏 -->
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                   Text="{Binding Status}" Margin="0,12,0,0"
                   Foreground="#6B7280" FontSize="12"/>
    </Grid>
</UserControl>
