<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KnowledgeWeakness.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="KnowledgeWeakness.App.Views.SubjectsView"
             x:DataType="vm:SubjectsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,360" RowSpacing="16" ColumnSpacing="16">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="card" Padding="18">
            <Grid ColumnDefinitions="Auto,220,Auto,220,*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="field-label" Text="编码"/>
                <TextBox Grid.Column="1" Text="{Binding NewCode}" PlaceholderText="例如：geography-g8"/>
                <TextBlock Grid.Column="2" Classes="field-label" Text="名称"/>
                <TextBox Grid.Column="3" Text="{Binding NewName}" PlaceholderText="例如：初二地理"/>
                <Button Grid.Column="5" Content="新增学科" Command="{Binding AddCommand}" Classes="accent"/>
                <Button Grid.Column="6" Content="刷新" Command="{Binding LoadCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Classes="card-flush">
            <DataGrid ItemsSource="{Binding Subjects}"
                      SelectedItem="{Binding Selected}"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="220"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="知识库路径" Binding="{Binding KnowledgeBasePath}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Classes="card" Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="学科详情" Classes="section-title"/>
                <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="10">
                    <TextBlock Classes="field-label" Text="ID"/>
                    <TextBlock Text="{Binding Selected.Id}" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Classes="field-label" Text="编码"/>
                    <TextBox Text="{Binding Selected.Code}"/>
                    <TextBlock Classes="field-label" Text="名称"/>
                    <TextBox Text="{Binding Selected.Name}"/>
                    <TextBlock Classes="field-label" Text="知识库路径"/>
                    <TextBox Text="{Binding Selected.KnowledgeBasePath}"
                             PlaceholderText="相对路径或绝对路径"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                        <Button Content="保存修改" Command="{Binding SaveCommand}" Classes="accent"/>
                        <Button Content="{Binding DeleteButtonText}" Command="{Binding DeleteCommand}" Classes="danger"/>
                    </StackPanel>
                </StackPanel>
                <Border IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"
                        Background="{StaticResource SubtlePanelBrush}"
                        CornerRadius="8"
                        Padding="16">
                    <TextBlock Text="选择左侧学科后，在这里维护名称、编码和知识库路径。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="status-bar">
            <TextBlock Text="{Binding Status}" Classes="status-text"/>
        </Border>
    </Grid>
</UserControl>
