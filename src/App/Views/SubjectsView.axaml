<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KnowledgeWeakness.App.ViewModels"
             xmlns:domain="using:KnowledgeWeakness.Core.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="KnowledgeWeakness.App.Views.SubjectsView"
             x:DataType="vm:SubjectsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,320">

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="White"
                CornerRadius="8" Padding="16" Margin="0,0,0,12"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="编码" VerticalAlignment="Center"/>
                <TextBox Text="{Binding NewCode}" Width="200" PlaceholderText="如：geography-g8"/>
                <TextBlock Text="名称" VerticalAlignment="Center"/>
                <TextBox Text="{Binding NewName}" Width="200" PlaceholderText="如：初二地理"/>
                <Button Content="新增" Command="{Binding AddCommand}" Classes="accent"/>
                <Button Content="刷新" Command="{Binding LoadCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="White"
                CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1"
                Margin="0,0,12,0">
            <DataGrid ItemsSource="{Binding Subjects}"
                      SelectedItem="{Binding Selected}"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="200"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="知识库路径" Binding="{Binding KnowledgeBasePath}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="White"
                CornerRadius="8" Padding="16"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="详情" FontWeight="SemiBold" FontSize="14"/>
                <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="8">
                    <TextBlock Text="ID"/>
                    <TextBlock Text="{Binding Selected.Id}" FontWeight="Bold"/>
                    <TextBlock Text="编码"/>
                    <TextBox Text="{Binding Selected.Code}"/>
                    <TextBlock Text="名称"/>
                    <TextBox Text="{Binding Selected.Name}"/>
                    <TextBlock Text="知识库路径"/>
                    <TextBox Text="{Binding Selected.KnowledgeBasePath}"
                             PlaceholderText="相对路径或绝对路径"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Content="保存" Command="{Binding SaveCommand}" Classes="accent"/>
                        <Button Content="删除" Command="{Binding DeleteCommand}" Foreground="#DC2626"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"
                           Text="选择左侧记录查看详情" Foreground="#6B7280"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                   Text="{Binding Status}" Margin="0,12,0,0"
                   Foreground="#6B7280" FontSize="12"/>
    </Grid>
</UserControl>
