<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KnowledgeWeakness.App.ViewModels"
             xmlns:domain="using:KnowledgeWeakness.Core.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="KnowledgeWeakness.App.Views.TrendsView"
             x:DataType="vm:TrendsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Border Grid.Row="0" Classes="card" Padding="16">
            <Grid ColumnDefinitions="Auto,180,Auto,180,*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="field-label" Text="学生"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Students}"
                          SelectedItem="{Binding SelectedStudent}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="domain:Student">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Classes="field-label" Text="学科"/>
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding Subjects}"
                          SelectedItem="{Binding SelectedSubject}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="domain:Subject">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="5" Content="刷新" Command="{Binding LoadCommand}" Classes="accent"/>
                <Button Grid.Column="6" Content="清除筛选" Command="{Binding ClearFilterCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="summary-pill">
            <TextBlock Text="{Binding Summary}" Foreground="#334155" FontWeight="SemiBold"/>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="14">
            <Border Grid.Column="0" Classes="card" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="折线图暂不可用"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="LiveChartsCore 与 Avalonia 12 的 SkiaSharp 依赖版本冲突，待升级到兼容版本后恢复。"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               MaxWidth="280"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card-flush">
                <DataGrid ItemsSource="{Binding Points}"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserResizeColumns="True"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="卷子" Binding="{Binding PaperTitle}" Width="*" MinWidth="100"/>
                        <DataGridTextColumn Header="题数" Binding="{Binding Total}" Width="60"/>
                        <DataGridTextColumn Header="错题" Binding="{Binding Wrong}" Width="60"/>
                        <DataGridTextColumn Header="正确率" Binding="{Binding AccuracyText}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Classes="status-bar">
            <TextBlock Text="{Binding Status}" Classes="status-text"/>
        </Border>
    </Grid>
</UserControl>
